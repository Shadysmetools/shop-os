# Copy this file to .env.local and fill in the values. Never commit .env.local.
# For local development, `pnpm db:start` prints these values (API_URL, PUBLISHABLE_KEY, SECRET_KEY).

# Supabase API address. Local: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Browser-safe key. RLS decides what it can see.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only key. It skips RLS. Never use it in browser code (CLAUDE.md rule 3).
SUPABASE_SECRET_KEY=
